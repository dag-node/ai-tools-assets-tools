#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# tools/new-publisher -- turns an unmodified copy of the publisher template into the publisher's own repository.
#
# ```bash
# python3 tools/new-publisher --repository <owner>/<repo> --contact <email> [--root DIR] [--source URL] [--maintainers <email>,...]
#     [--holder TEXT] [--license ID] [--set NAME] [--summary TEXT] [--code-owner @handle]... [--job-id ID]
#     [--tag-signer FINGERPRINT]... [--tag-signer-key-url URL] [--artifact-signer FINGERPRINT] [--description TEXT]
# ```
#
# The copy is dag-node/ai-tools-assets-template as generated: `publisher.conf` holds the placeholder `change-me`,
# `sets/` holds `change-me-example` alone, and each file the command rewrites carries the template line it replaces
# (the workflows' job key `ai-tools-assets-template:` and `MIT-0` header, the release signer inputs, the licence's
# holder line, `REUSE.toml`'s package lines and annotation), matched as text. Every input and every one of those files
# is checked before the first write, so a refusal leaves the tree as it was; a second run on an initialized copy is
# refused rather than repeated. The publisher is the owner lower-cased and `source` its GitHub URL, the two values
# `check-publisher --repository` holds a release to; `--source` names another URL for a publisher whose hosts take its
# sets from elsewhere, which the pull-request checks accept and the release check does not. The command writes `publisher.conf`, `REUSE.toml`, `CODEOWNERS`
# and `README.md` whole, rewrites the template lines of the two workflows, writes `LICENSE` from the licence text with
# its holder line filled, takes `LICENSES/<ID>.txt` from the copy or from `LICENSES/` beside this directory (removing
# the template's `MIT-0` text when the licence differs, since `reuse lint` refuses an unused text), removes the example
# set, and runs `new-set` and `new-asset` for the publisher's first set. Every file goes through
# `tools/lib/safe_write.py`, so no write follows a link. It does not run git: it prints the steps that follow as `next`
# lines. Standard library only.
from __future__ import annotations

import argparse
import datetime
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys

TOOLS = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(TOOLS / "lib"))

import asset_format as fmt  # noqa: E402
from findings import FindingCollector  # noqa: E402
from key_value_config import parse_key_value_text  # noqa: E402
from safe_read import RefusedRead, open_directory, open_root, read_text_under  # noqa: E402
from safe_write import create_file, replace_file  # noqa: E402
from set_validation import read_reserved_words  # noqa: E402

TEMPLATE_SET = "change-me-example"
TEMPLATE_LICENSE = "MIT-0"
TEMPLATE_JOB_LINE = "  ai-tools-assets-template:"
# `reuse lint` reads the tag in these literals as an expression of this file, so they sit in ignored blocks.
# REUSE-IgnoreStart
HEADER_LINE = "# SPDX-License-Identifier: {license}"
TEMPLATE_HEADER_LINE = HEADER_LINE.format(license=TEMPLATE_LICENSE)
TEMPLATE_SIGNER_LINES = {
    "tag-signer-fingerprints": "      tag-signer-fingerprints: change-me",
    "tag-signer-key-url": "      tag-signer-key-url: https://github.com/change-me.gpg",
    "artifact-signer-fingerprint": "      artifact-signer-fingerprint: change-me",
}
TEMPLATE_REUSE_LINES = (
    f'SPDX-PackageName = "{fmt.TEMPLATE_PACKAGE_NAME}"',
    f'SPDX-PackageDownloadLocation = "https://github.com/dag-node/{fmt.TEMPLATE_PACKAGE_NAME}"',
    f'SPDX-License-Identifier = "{TEMPLATE_LICENSE}"',
)
# REUSE-IgnoreEnd
VALIDATE_WORKFLOW = pathlib.PurePath(".github", "workflows", "validate.yml")
RELEASE_WORKFLOW = pathlib.PurePath(".github", "workflows", "release.yml")
CODEOWNERS = pathlib.PurePath(".github", "CODEOWNERS")

OWNER_PATTERN = re.compile(r"^[A-Za-z0-9-]+$")
REPOSITORY_NAME_PATTERN = re.compile(r"^[A-Za-z0-9._-]+$")
# A KEY=value list item and a manifest address: no whitespace, comma, quote, bracket or comment character.
EMAIL_PATTERN = re.compile(r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+$")
CODE_OWNER_PATTERN = re.compile(r"^@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:/[A-Za-z0-9][A-Za-z0-9._-]*)?$")
JOB_ID_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*$")
FINGERPRINT_PATTERN = re.compile(r"^[0-9A-Fa-f]{40}$")
KEY_URL_PATTERN = re.compile(r"^https://[^\s\"'<>]+$")
# A `KEY=value` value and a TOML basic string: a scheme, then no whitespace, quote, bracket, comma or `#`.
SOURCE_PATTERN = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*://[^\s\"'<>#\[\],\\]+$")
LICENSE_ID_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+-]*$")
# The holder line of a published licence text that carries one: `Copyright (c) <year> <copyright holders>` (MIT),
# `Copyright <YEAR> <COPYRIGHT HOLDER>` (MIT-0). It is read within the text's opening lines.
HOLDER_LINE = re.compile(r"^(?P<prefix>Copyright (?:\(c\) )?)<[^>]+> <[^>]+>\s*$")
HOLDER_LINE_SEARCH_LINES = 5
TEMPLATE_HOLDER_LINE = re.compile(r"^Copyright \S.*$")
SKILL_DESCRIPTION = "Prints a greeting. Replace it with your first skill."

