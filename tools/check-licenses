#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# tools/check-licenses -- holds every file of a repository to the SPDX allowlist in force.
#
# ```bash
# python3 tools/check-licenses [--root DIR] [--allow ID]... [--exception GLOB=ID]...
# ```
#
# Each tracked file's licence is its own `SPDX-License-Identifier` header, or else the last matching `[[annotations]]`
# table of `REUSE.toml`, as REUSE resolves it; a file with neither is reported. Every identifier of that expression is
# on the list in force -- `publisher.conf` `licenses=`, or the GPLv3-compatible permissive default, plus each `--allow`
# -- and has its text under `LICENSES/`. An `--exception` admits one identifier for the files its glob matches alone,
# which is how this repository carries its `AGPL-3.0-only` `formatters/` beside an MIT tree. `LICENSE`, `LICENSES/`
# and `REUSE.toml` are not judged: they are the texts and the annotations themselves. Standard library only.
from __future__ import annotations

import argparse
import pathlib
import subprocess
import sys

TOOLS = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(TOOLS / "lib"))

import asset_format as fmt  # noqa: E402
from findings import FindingCollector  # noqa: E402
from key_value_config import read_key_value_file  # noqa: E402
from license_policy import (allowlist_in_force, annotation_for, check_declared_license, check_license_texts,  # noqa: E402
                            exception_for, file_spdx_expression, read_reuse_annotations)

NOT_JUDGED = ("LICENSE", "REUSE.toml")


def tracked_files(root: pathlib.Path):
    completed = subprocess.run(["git", "-C", str(root), "ls-files", "-z"], capture_output=True, text=True)
    if completed.returncode == 0:
        return [pathlib.Path(name) for name in completed.stdout.split("\0") if name]
    return sorted(path.relative_to(root) for path in root.rglob("*") if path.is_file() and ".git" not in path.parts)


def main() -> int:
    parser = argparse.ArgumentParser(description="Hold every file's licence to the SPDX allowlist in force.")
    parser.add_argument("--root", type=pathlib.Path, default=pathlib.Path("."), help="the repository (default: the current directory)")
    parser.add_argument("--allow", action="append", default=[], metavar="ID", help="an identifier admitted beside the list in force")
    parser.add_argument("--exception", action="append", default=[], metavar="GLOB=ID", help="admit ID for the files GLOB matches")
    args = parser.parse_args()
    root = args.root.resolve()
    collector = FindingCollector("check-licenses")
    publisher_path = root / "publisher.conf"
    publisher = read_key_value_file(publisher_path) if publisher_path.is_file() else None
    allowlist, allowlist_error = allowlist_in_force(publisher)
    if allowlist_error:
        collector.refuse("publisher.conf", "license.allowlist", allowlist_error)
    allowlist = tuple(allowlist) + tuple(args.allow)
    exceptions = []
    for item in args.exception:
        if "=" not in item:
            parser.error(f"--exception takes GLOB=ID, not `{item}`")
        glob, identifier = item.rsplit("=", 1)
        exceptions.append((glob, identifier))
    reuse_path = root / "REUSE.toml"
    annotations = read_reuse_annotations(reuse_path) if reuse_path.is_file() else []
    used = set()
    for relative_path in tracked_files(root):
        path_text = relative_path.as_posix()
        if relative_path.name in NOT_JUDGED or relative_path.parts[0] == fmt.LICENSE_TEXTS_DIRECTORY:
            continue
        expression = file_spdx_expression(root / relative_path) or annotation_for(path_text, annotations)
        if expression is None:
            collector.refuse(path_text, "license.file", "states no licence: no SPDX header and no REUSE.toml annotation matches")
            continue
        admitted = exception_for(path_text, exceptions)
        in_force = allowlist + ((admitted,) if admitted else ())
        evaluation = check_declared_license(collector, path_text, expression, in_force, "the file's licence")
        if evaluation.is_well_formed:
            used.update(evaluation.identifiers)
    check_license_texts(collector, "LICENSES", used, [root])
    if not collector.has_refusals():
        print(f"check-licenses: every file is under {', '.join(sorted(used))}; texts present")
    return collector.report()


if __name__ == "__main__":
    sys.exit(main())
