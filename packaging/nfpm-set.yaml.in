# SPDX-License-Identifier: MIT
# The nFPM configuration of a set's RPM; packaging/render-nfpm.py replaces each placeholder, an upper-case key between
# two at signs, with a quoted value. The package installs the staged set, SHA256SUMS and SHA256SUMS.asc included, under
# /usr/share/ai-tools-assets/<set>/ and owns that directory, so `rpm -e` removes it; it co-owns
# /usr/share/ai-tools-assets with every other set's package, so the last removal removes that too. It declares
# no Requires. umask 0o022 clears group and other write from every mode nFPM reads from the staged tree, where nFPM's
# default 0o002 keeps group write; buildhost and SOURCE_DATE_EPOCH (from the environment) fix the header fields that
# would differ between two builds of one tag.
name: @NAME@
arch: all
platform: linux
version: @VERSION@
version_schema: semver
release: "1"
maintainer: @MAINTAINER@
vendor: @VENDOR@
homepage: @HOMEPAGE@
license: @LICENSE@
description: @SUMMARY@
umask: 0o022
contents:
  - dst: @INSTALL_ROOT@
    type: dir
    file_info:
      mode: 0755
  - dst: @DESTINATION@
    type: dir
    file_info:
      mode: 0755
  - src: @STAGED@
    dst: @DESTINATION@
    type: tree
rpm:
  summary: @SUMMARY@
  buildhost: ai-tools-assets-release
